// Prisma schema for AI Relationship Mediation App

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - represents individual users in the app
model User {
  id        String      @id @default(uuid())
  email     String      @unique
  password  String      // Will be hashed
  name      String
  gender    String?
  onboardingData Json?  @map("onboarding_data")
  timezone  String      @default("UTC")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  // Consent fields
  tosVersionAgreed      String?   @map("tos_version_agreed") @db.VarChar(10)
  privacyVersionAgreed  String?   @map("privacy_version_agreed") @db.VarChar(10)
  consentAgreedAt       DateTime? @map("consent_agreed_at")
  dateOfBirthConfirmed  Boolean   @default(false) @map("date_of_birth_confirmed")
  isMinorFlagged        Boolean   @default(false) @map("is_minor_flagged")

  couplesAsUserA Couple[]      @relation("UserACouples")
  couplesAsUserB Couple[]      @relation("UserBCouples")
  interviews     Interview[]
  consentLogs    ConsentLog[]

  @@map("users")
}

model Couple {
  id                String   @id @default(uuid())
  userAId           String   @map("user_a_id")
  userBId           String?  @map("user_b_id")
  inviteToken       String?  @unique @map("invite_token")
  datingStartDate   String?  @map("dating_start_date")
  onboardingData    Json?    @map("onboarding_data")
  userASignedAt     DateTime? @map("user_a_signed_at")
  userBSignedAt     DateTime? @map("user_b_signed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  userA             User     @relation("UserACouples", fields: [userAId], references: [id])
  userB             User?    @relation("UserBCouples", fields: [userBId], references: [id])
  sessions          Session[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("couples")
}

model Session {
  id                   String   @id @default(uuid())
  coupleId             String   @map("couple_id")
  status               String
  initiatedBy          String   @map("initiated_by")
  topic                String?
  context              String?
  unpackingReadyAt     DateTime? @map("unpacking_ready_at")
  unpackingAutoUnlockAt DateTime? @map("unpacking_auto_unlock_at")
  unpackingWaitUserA   Boolean  @default(false) @map("unpacking_wait_user_a")
  unpackingWaitUserB   Boolean  @default(false) @map("unpacking_wait_user_b")
  manualReminderSentAt DateTime? @map("manual_reminder_sent_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  couple      Couple   @relation(fields: [coupleId], references: [id])
  interviews  Interview[]
  unpacking   Unpacking?

  @@index([coupleId])
  @@index([coupleId, status])
  @@map("sessions")
}

model Interview {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  userId      String   @map("user_id")
  responses   Json
  notes       String?
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  session     Session  @relation(fields: [sessionId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@map("interviews")
}

model Unpacking {
  id                    String   @id @default(uuid())
  sessionId             String   @unique @map("session_id")
  surfaceConflict       String   @map("surface_conflict")
  partnerAExperience    String   @map("partner_a_experience") @db.Text
  partnerBExperience    String   @map("partner_b_experience") @db.Text
  sharedTruths          Json     @map("shared_truths")
  deeperInsight         String   @map("deeper_insight") @db.Text
  patternRecognition    String?  @map("pattern_recognition") @db.Text
  tone                  String
  feedbackCount         Int      @default(0) @map("feedback_count")
  lastFeedbackReason    String?  @map("last_feedback_reason") @db.Text
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  session               Session  @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("unpackings")
}

// Consent audit log — records every time a user agrees to ToS/PP
model ConsentLog {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  tosVersion      String   @map("tos_version") @db.VarChar(10)
  privacyVersion  String   @map("privacy_version") @db.VarChar(10)
  agreedAt        DateTime @default(now()) @map("agreed_at")
  appVersion      String?  @map("app_version") @db.VarChar(20)
  platform        String?  @db.VarChar(10) // 'ios' or 'android'

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("consent_log")
}
