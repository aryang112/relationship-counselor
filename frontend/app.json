{
  "expo": {
    "name": "Relation Counselor",
    "slug": "relation-counselor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "relationcounselor",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.relationcounselor.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Relate uses your microphone so you can speak your feelings aloud instead of typing during a difficult moment. Voice input is optional — you can always type instead.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F4"
      },
      "package": "com.relationcounselor.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E07832"
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "a82698ed-d0a0-43fc-a29a-aa372e1422ac"
      }
    },
    "owner": "aryangupta074"
  }
}
